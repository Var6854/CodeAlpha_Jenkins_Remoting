# ==============================================================================
# CodeAlpha Distributed Build Execution - Environment Variables Template
# ==============================================================================
# COPY THIS FILE TO '.env' AND REPLACE PLACEHOLDERS WITH STRONG, GENERATED SECRETS.
# DO NOT COMMIT THE REAL '.env' FILE TO VERSION CONTROL (.gitignore protects it).
# ==============================================================================

# Jenkins Administrator Credentials
# Choose a strong, unique password for your local Jenkins Controller admin account.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change_this_to_a_secure_password_min_16_chars

# Jenkins Controller URL
JENKINS_CONTROLLER_URL=http://localhost:8080/

# Inbound Agent Secrets (Generated by Jenkins Controller)
# Obtain these from: Jenkins Dashboard -> Manage Jenkins -> Nodes -> [Agent Name]
# Never use fake or arbitrary strings; inbound agents must authenticate with the
# genuine 64-character HMAC token generated by your Jenkins Controller instance.
JENKINS_AGENT_SECRET_LINUX=replace_with_genuine_linux_agent_secret_from_controller_ui
JENKINS_AGENT_SECRET_WINDOWS=replace_with_genuine_windows_agent_secret_from_controller_ui
